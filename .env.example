# Local development values only; replace before any shared deployment.
POSTGRES_USER=lumasoa
POSTGRES_PASSWORD=local_dev_only
RABBITMQ_USER=luma
RABBITMQ_PASSWORD=local_dev_only
# Required: generate a random value with scripts/init-local-env.cjs; no fallback.
JWT_SECRET=
JWT_ISSUER=lumasoa
JWT_AUDIENCE=lumasoa-frontend
APP_ENV=local
UPSTREAM_TIMEOUT_MS=3000
PAYMENT_PROVIDER_MODE=mock
PAYMENT_MOCK_DELAY_SECONDS=5

# === Cloudinary: dien 3 gia tri tu Console > Settings > API Keys ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Ten 2 signed presets da tao; chi sua neu ban dat ten khac.
CLOUDINARY_AVATAR_UPLOAD_PRESET=lamu_avatar_signed
CLOUDINARY_ORG_COVER_UPLOAD_PRESET=lamu_org_cover_signed
CLOUDINARY_ASSET_PREFIX=lamu/development
MEDIA_UPLOAD_INTENT_TTL_SECONDS=600
AVATAR_MAX_BYTES=5242880
ORG_COVER_MAX_BYTES=10485760

# === Gmail SMTP: dien SMTP_USER, SMTP_PASSWORD va MAIL_FROM ===
# SMTP_USER: dia chi Gmail day du dung gui OTP.
# SMTP_PASSWORD: App Password cua Google, khong phai mat khau dang nhap Gmail.
# MAIL_FROM: "Lamu <dia-chi-gmail-giong-SMTP_USER>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# === Recovery: key rieng, moi key la 32 byte ngau nhien ma hoa hex (64 ky tu) ===
# File .env local da duoc tao key khi chuan bi cau hinh; giu bi mat va on dinh.
# Khi copy template moi: sinh 2 key doc lap; khong copy JWT_SECRET.
PASSWORD_RESET_OTP_HMAC_KEY=
MAIL_JOB_ENCRYPTION_KEY=
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_TOKEN_TTL_SECONDS=300
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EMAIL_HOURLY_LIMIT=5
PASSWORD_RESET_IP_HOURLY_LIMIT=20

# Runtime defaults below do not require changing existing secrets.
# Gateway only trusts explicitly listed upstream proxy networks. Empty ignores X-Forwarded-For.
GATEWAY_TRUSTED_PROXY_CIDRS=
# Provider deadline includes metadata response body; leave DB/serialization headroom at Gateway.
CLOUDINARY_TIMEOUT_MS=4000
MEDIA_UPSTREAM_TIMEOUT_MS=8000
MEDIA_MAX_PIXELS=40000000
MEDIA_MAX_PENDING_INTENTS=10
MEDIA_HOURLY_INTENT_LIMIT=30
# Keep this identifier stable. Rotation requires retaining old decryption keys until jobs drain.
MAIL_JOB_KEY_ID=v1
# Optional JSON object mapping previous key IDs to 64-hex keys; never commit populated values.
MAIL_JOB_PREVIOUS_KEYS_JSON=
