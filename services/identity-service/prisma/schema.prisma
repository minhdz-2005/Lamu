generator client {
 provider = "prisma-client"
 output = "../src/generated"
 moduleFormat = "cjs"
}
datasource db {
 provider = "postgresql"
}
model User {
 id String @id @default(uuid()) @db.Uuid
 email String @unique @db.Citext
 display_name String
 password_hash String
 status String @default("ACTIVE")
 created_at DateTime @default(now()) @db.Timestamptz(6)
 updated_at DateTime @updatedAt @db.Timestamptz(6)
 sessions RefreshSession[]
 organizations Organization[]
 memberships Membership[]
 idempotency_records IdempotencyRecord[] @relation("IdempotencyActor")
 targeted_idempotency_records IdempotencyRecord[] @relation("IdempotencyTarget")
 sent_invitations OrganizationInvitation[] @relation("Inviter")
 received_invitations OrganizationInvitation[] @relation("Invitee")
 challenges PasswordResetChallenge[]
 avatar_asset_id String? @unique @db.Uuid
 avatar_revision BigInt @default(0)
 avatar_asset MediaAsset? @relation("UserAvatar",fields:[avatar_asset_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 upload_intents MediaUploadIntent[] @relation("IntentActor")
 avatar_intents MediaUploadIntent[] @relation("AvatarTarget")
 @@map("users")
}
model PasswordResetChallenge {
 id String @id @db.Uuid
 user_id String @db.Uuid
 user User @relation(fields:[user_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 code_digest String @db.Char(64)
 generation String @unique @db.Uuid
 created_at DateTime @default(now()) @db.Timestamptz(6)
 expires_at DateTime @db.Timestamptz(6)
 failed_attempts Int @default(0)
 verified_at DateTime? @db.Timestamptz(6)
 consumed_at DateTime? @db.Timestamptz(6)
 token_digest String? @unique @db.Char(64)
 token_expires_at DateTime? @db.Timestamptz(6)
 jobs SecurityMailJob[]
 @@index([user_id,created_at])
 @@index([expires_at])
 @@map("password_reset_challenges")
}
model SecurityMailJob {
 id String @id @db.Uuid
 challenge_id String? @db.Uuid
 challenge PasswordResetChallenge? @relation(fields:[challenge_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 generation String @db.Uuid
 kind String
 ciphertext String?
 key_id String
 status String @default("PENDING")
 attempts Int @default(0)
 next_attempt_at DateTime @default(now()) @db.Timestamptz(6)
 expires_at DateTime @db.Timestamptz(6)
 lease_owner String? @db.Uuid
 lease_until DateTime? @db.Timestamptz(6)
 created_at DateTime @default(now()) @db.Timestamptz(6)
 finished_at DateTime? @db.Timestamptz(6)
 @@index([status,next_attempt_at])
 @@index([expires_at])
 @@map("security_mail_jobs")
}
model SecurityRateBucket {
 key String @id @db.Char(64)
 count Int
 expires_at DateTime @db.Timestamptz(6)
 @@index([expires_at])
 @@map("security_rate_buckets")
}
model Organization {
 id String @id @default(uuid()) @db.Uuid
 name String
 description String? @db.Text
 slug String @unique
 created_by String @db.Uuid
 creator User @relation(fields:[created_by],references:[id],onDelete:Restrict)
 memberships Membership[]
 roles Role[]
 idempotency_records IdempotencyRecord[]
 invitations OrganizationInvitation[]
 cover_asset_id String? @unique @db.Uuid
 cover_revision BigInt @default(0)
 cover_asset MediaAsset? @relation("OrganizationCover",fields:[cover_asset_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 cover_intents MediaUploadIntent[]
 @@map("organizations")
}
model MediaAsset {
 id String @id @db.Uuid
 asset_id String @unique
 public_id String @unique
 version BigInt
 secure_url String
 display_url String
 format String
 bytes Int
 width Int
 height Int
 status String @default("ACTIVE")
 avatar_user User? @relation("UserAvatar")
 cover_organization Organization? @relation("OrganizationCover")
 intent MediaUploadIntent?
 @@map("media_assets")
}
model MediaUploadIntent {
 id String @id @db.Uuid
 actor_id String @db.Uuid
 actor User @relation("IntentActor",fields:[actor_id],references:[id],onDelete:NoAction,onUpdate:NoAction)
 user_id String? @db.Uuid
 user User? @relation("AvatarTarget",fields:[user_id],references:[id],onDelete:NoAction,onUpdate:NoAction)
 organization_id String? @db.Uuid
 organization Organization? @relation(fields:[organization_id],references:[id],onDelete:NoAction,onUpdate:NoAction)
 purpose String
 expected_public_id String @unique
 expected_revision BigInt
 created_at DateTime @default(now()) @db.Timestamptz(6)
 expires_at DateTime @db.Timestamptz(6)
 watch_until DateTime @db.Timestamptz(6)
 state String @default("PENDING")
 committed_at DateTime? @db.Timestamptz(6)
 asset_id String? @unique @db.Uuid
 asset MediaAsset? @relation(fields:[asset_id],references:[id],onDelete:NoAction,onUpdate:NoAction)
 result Json?
 cleanup MediaCleanupJob?
 @@index([actor_id,expires_at])
 @@map("media_upload_intents")
}
model MediaCleanupJob {
 id String @id @db.Uuid
 intent_id String @unique @db.Uuid
 intent MediaUploadIntent @relation(fields:[intent_id],references:[id],onDelete:NoAction,onUpdate:NoAction)
 status String @default("PENDING")
 attempts Int @default(0)
 next_attempt_at DateTime @db.Timestamptz(6)
 lease_owner String? @db.Uuid
 lease_until DateTime? @db.Timestamptz(6)
 @@index([status,next_attempt_at])
 @@map("media_cleanup_jobs")
}
model Membership {
 id String @id @default(uuid()) @db.Uuid
 organization_id String @db.Uuid
 user_id String @db.Uuid
 status String @default("ACTIVE")
 joined_at DateTime @default(now()) @db.Timestamptz(6)
 membership_revision BigInt @default(1)
 organization Organization @relation(fields:[organization_id],references:[id],onDelete:Restrict)
 user User @relation(fields:[user_id],references:[id],onDelete:Restrict)
 assignments MembershipRole[]
 @@unique([organization_id,user_id])
 @@map("memberships")
}
model IdempotencyRecord {
 id String @id @default(uuid()) @db.Uuid
 actor_user_id String @db.Uuid
 operation String
 idempotency_key String @db.VarChar(128)
 request_hash String @db.Char(64)
 target_organization_id String @db.Uuid
 target_user_id String? @db.Uuid
 target_invitation_id String? @db.Uuid
 target_invitation OrganizationInvitation? @relation(fields:[target_invitation_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 response_status Int
 response_body Json
 completed_at DateTime @db.Timestamptz(6)
 expires_at DateTime @db.Timestamptz(6)
 actor User @relation("IdempotencyActor",fields:[actor_user_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 target_organization Organization @relation(fields:[target_organization_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 target_user User? @relation("IdempotencyTarget",fields:[target_user_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 @@unique([actor_user_id,operation,idempotency_key])
 @@index([expires_at])
 @@map("idempotency_records")
}
model OrganizationInvitation {
 id String @id @default(uuid()) @db.Uuid
 organization_id String @db.Uuid
 inviter_user_id String @db.Uuid
 invitee_user_id String @db.Uuid
 roles Json
 status String @default("PENDING")
 created_at DateTime @db.Timestamptz(6)
 expires_at DateTime @db.Timestamptz(6)
 processed_at DateTime? @db.Timestamptz(6)
 organization Organization @relation(fields:[organization_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 inviter User @relation("Inviter",fields:[inviter_user_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 invitee User @relation("Invitee",fields:[invitee_user_id],references:[id],onDelete:Restrict,onUpdate:NoAction)
 idempotency_records IdempotencyRecord[]
 @@index([invitee_user_id,created_at(sort: Desc),id(sort: Desc)],map:"organization_invitations_inbox_idx")
 @@index([organization_id,created_at(sort: Desc),id(sort: Desc)],map:"organization_invitations_outgoing_idx")
 @@map("organization_invitations")
}
model Role {
 id String @id @default(uuid()) @db.Uuid
 organization_id String? @db.Uuid
 code String
 name String
 scope String
 organization Organization? @relation(fields:[organization_id],references:[id],onDelete:Restrict)
 permissions RolePermission[]
 assignments MembershipRole[]
 @@unique([organization_id,code])
 @@map("roles")
}
model Permission {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 description String
 roles RolePermission[]
 @@map("permissions")
}
model RolePermission {
 role_id String @db.Uuid
 permission_id String @db.Uuid
 role Role @relation(fields:[role_id],references:[id],onDelete:Restrict)
 permission Permission @relation(fields:[permission_id],references:[id],onDelete:Restrict)
 @@id([role_id,permission_id])
 @@map("role_permissions")
}
model MembershipRole {
 id String @id @default(uuid()) @db.Uuid
 membership_id String @db.Uuid
 role_id String @db.Uuid
 resource_type String
 resource_id String? @db.Uuid
 membership Membership @relation(fields:[membership_id],references:[id],onDelete:Restrict)
 role Role @relation(fields:[role_id],references:[id],onDelete:Restrict)
 @@unique([membership_id,role_id,resource_type,resource_id])
 @@map("membership_roles")
}
model RefreshSession {
 id String @id @default(uuid()) @db.Uuid
 user_id String @db.Uuid
 token_hash String @unique
 created_at DateTime @default(now()) @db.Timestamptz(6)
 expires_at DateTime @db.Timestamptz(6)
 revoked_at DateTime? @db.Timestamptz(6)
 user User @relation(fields:[user_id],references:[id],onDelete:Restrict)
 @@index([user_id])
 @@map("refresh_sessions")
}
model OutboxEvent {
 event_id String @id @db.Uuid
 event_type String
 version Int
 occurred_at DateTime @db.Timestamptz(6)
 aggregate_type String
 aggregate_id String @db.Uuid
 producer String
 payload Json
 status String @default("PENDING")
 attempt_count Int @default(0)
 next_attempt_at DateTime @default(now()) @db.Timestamptz(6)
 claim_token String? @db.Uuid
 lease_until DateTime? @db.Timestamptz(6)
 last_attempt_at DateTime? @db.Timestamptz(6)
 sent_at DateTime? @db.Timestamptz(6)
 last_error_code String? @db.VarChar(64)
 parked_at DateTime? @db.Timestamptz(6)
 delivery_attempts OutboxDeliveryAttempt[]
 replays OutboxReplay[]
 @@index([status,occurred_at])
 @@map("outbox_events")
}

model OutboxDeliveryAttempt {
 claim_token String @id @db.Uuid
 event_id String @db.Uuid
 attempt_number Int
 started_at DateTime @db.Timestamptz(6)
 finished_at DateTime? @db.Timestamptz(6)
 outcome String? @db.VarChar(64)
 event OutboxEvent @relation(fields:[event_id],references:[event_id],onDelete:Restrict,onUpdate:NoAction)
 @@index([event_id,started_at],map:"outbox_delivery_attempts_event_idx")
 @@map("outbox_delivery_attempts")
}

model OutboxReplay {
 id String @id @db.Uuid
 event_id String @db.Uuid
 replayed_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 reason String @db.VarChar(256)
 previous_attempt_count Int
 event OutboxEvent @relation(fields:[event_id],references:[event_id],onDelete:Restrict,onUpdate:NoAction)
 @@map("outbox_replays")
}

