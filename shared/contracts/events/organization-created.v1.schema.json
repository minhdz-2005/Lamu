{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrganizationCreated v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "version",
    "occurred_at",
    "aggregate_type",
    "aggregate_id",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "OrganizationCreated"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "aggregate_type": {
      "const": "organization"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "const": "identity-service"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "slug",
        "created_by"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Trimmed and lowercase before validation."
        },
        "created_by": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
