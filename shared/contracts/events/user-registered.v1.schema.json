{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserRegistered v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "version",
    "occurred_at",
    "aggregate_type",
    "aggregate_id",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "UserRegistered"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "aggregate_type": {
      "const": "user"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "const": "identity-service"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "email",
        "display_name"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
