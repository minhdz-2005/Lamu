{
  "openapi": "3.0.3",
  "info": {
    "title": "Identity M1",
    "version": "1.0.0",
    "description": "Accepted 2026-11-13. Auth POST success 200; no Idempotency-Key. Refresh rotates within absolute seven-day session; logout requires matching verified sub/sid and current refresh. Revoked retry allowed until refresh expiry, access must remain valid. Email/display_name trimmed; password preserved. Local trusted network only; internal context headers cannot be supplied by public clients. LOCKED valid credentials: 403. Access may survive logout for up to 900s."
  },
  "servers": [
    {
      "url": "http://identity-service:8080"
    }
  ],
