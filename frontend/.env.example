# Sao chép thành frontend/.env.local — không commit file that.
# Để trống: UI gọi /api cùng origin, tức là mock gateway viết ngay trong app (đủ demo cả 5 trang).
# Khi Gateway thật chạy xong, trỏ về nó:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_API_BASE_URL=

# Mock confirm giao dịch sau bao nhiêu giây ( khớp PAYMENT_MOCK_DELAY_SECONDS của Payment service).
NEXT_PUBLIC_MOCK_PAYMENT_DELAY_SECONDS=5
