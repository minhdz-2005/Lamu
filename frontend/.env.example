# Sao chép thành frontend/.env.local — không commit file that.
# Build-time flag: mock hoặc real; thay đổi cần restart dev / rebuild production và reload mọi tab.
NEXT_PUBLIC_AUTH_MODE=mock
# Server-only fixed origin, KHÔNG có /api. Browser không gọi trực tiếp URL này.
IDENTITY_GATEWAY_URL=http://127.0.0.1:8080
# Optional. Match the Identity ORG_COVER_MAX_BYTES setting (default 10 MiB).
NEXT_PUBLIC_ORG_COVER_MAX_BYTES=10485760
# UX resend cooldown; phải đồng bộ PASSWORD_RESET_RESEND_COOLDOWN_SECONDS của Identity.
# Không phải bằng chứng mail đã được gửi, không suy ra OTP expiry từ HTTP 202.
NEXT_PUBLIC_RECOVERY_COOLDOWN_SECONDS=60
# NEXT_PUBLIC_API_BASE_URL cũ không còn được dùng; Event, vé và thanh toán dùng /api mock.

# Mock confirm giao dịch sau bao nhiêu giây ( khớp PAYMENT_MOCK_DELAY_SECONDS của Payment service).
NEXT_PUBLIC_MOCK_PAYMENT_DELAY_SECONDS=5
