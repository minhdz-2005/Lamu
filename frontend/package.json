{
  "name": "lumasoa-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:coverage": "c8 --reporter=text --check-coverage --lines=80 --branches=80 --functions=80 --statements=80 --include=src/lib/*.ts --exclude=src/lib/useSession.ts --include=src/features/auth/validation.ts --include=src/features/auth/recoveryState.ts node ../node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "test": "node ../node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "9.1.0",
    "typescript": "^7.0.2"
  }
}
